{
  "name": "diagnostics-exporter",
  "displayName": "Diagnostics Exporter",
  "description": "Exports VS Code diagnostics (Problems) to a JSON file for external tools/agents.",
  "version": "0.0.1",
  "publisher": "RaynoldVanHeyningen",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaynoldVanHeyningen/vscode-diagnostics-exporter"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
